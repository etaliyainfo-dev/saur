{%- liquid
  assign yova_product = product_card_product | default: card_product | default: product
  assign show_compare_price_enabled = true
  assign show_discount_enabled = true
  if show_compare_price == false
    assign show_compare_price_enabled = false
  endif
  if show_discount == false
    assign show_discount_enabled = false
  endif
  assign target = yova_product.selected_or_first_available_variant
  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: yova_product.price
  assign available = yova_product.available
  assign money_price = price | money
  if settings.currency_code_enabled
    assign money_price = price | money_with_currency
  endif
-%}
<div class="yova-card__price" role="group" aria-label="{{ 'products.product.price.regular_price' | t | default: 'Price' }}">
  <span class="yova-card__price-current">{{ money_price }}</span>
  {%- if show_compare_price_enabled and compare_at_price > price -%}
    <s class="yova-card__price-compare">{%- if settings.currency_code_enabled -%}{{ compare_at_price | money_with_currency }}{%- else -%}{{ compare_at_price | money }}{%- endif -%}</s>
  {%- endif -%}
  {%- if show_discount_enabled and compare_at_price > price -%}
    {%- assign discount = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round -%}
    <span class="yova-card__price-discount">{{ discount }}% {{ 'products.product.on_sale' | t | default: 'OFF' }}</span>
  {%- endif -%}
  {%- unless available -%}<span class="yova-card__soldout-label">{{ 'products.product.sold_out' | t }}</span>{%- endunless -%}
</div>
