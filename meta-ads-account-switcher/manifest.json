{
  "manifest_version": 3,
  "name": "Meta Ads Account Switcher",
  "description": "Save, search, favorite, import/export, scan visible Ads Manager dropdowns, and open Meta Ads accounts directly.",
  "version": "1.1.0",
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "host_permissions": ["https://adsmanager.facebook.com/*"],
  "action": {
    "default_title": "Meta Ads Switcher",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "32": "icons/icon32.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "commands": {
    "open-switcher": {
      "suggested_key": { "default": "Ctrl+Shift+M", "mac": "Alt+M" },
      "description": "Open Meta Ads Account Switcher"
    }
  },
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
