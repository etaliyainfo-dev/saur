<section class="featured featured--{{ section.settings.style }} page-width">
  <div class="section-head">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  {% assign collection = section.settings.collection %}

  {% if section.settings.style == 'showcase' %}
    <div class="watch-buy" data-showcase>
      <button class="icon-button showcase-arrow" type="button" data-showcase-prev aria-label="Previous">←</button>
      <div class="watch-buy-track" data-showcase-track>
        {% for product in collection.products limit: 5 %}
          <article class="watch-item{% if forloop.index == 3 %} is-active{% endif %}">
            <a href="{{ product.url }}">
              {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: product.title }}
              <h3>{{ product.title }}</h3>
            </a>
          </article>
        {% else %}
          {% for i in (1..3) %}
            <article class="watch-item{% if forloop.index == 2 %} is-active{% endif %}">
              {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
              <h3>Featured Product</h3>
            </article>
          {% endfor %}
        {% endfor %}
      </div>
      <button class="icon-button showcase-arrow" type="button" data-showcase-next aria-label="Next">→</button>
    </div>
  {% elsif section.settings.style == 'category' %}
    <div class="category-cards">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="category-card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.title }}
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
          <span>{{ block.settings.title }}</span>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="product-grid columns-{{ section.settings.columns }}">
      {% for product in collection.products limit: section.settings.product_limit %}
        {% render 'product-card', product: product, show_sale_badge: section.settings.show_sale_badge %}
      {% else %}
        {% for i in (1..section.settings.product_limit) %}
          <article class="product-card">
            {{ 'product-3' | placeholder_svg_tag: 'placeholder-svg product-card__image' }}
            <h3>Sample Product {{ i }}</h3>
            <p class="price">$49.00</p>
            <button class="button button--yellow" disabled>Add to cart</button>
          </article>
        {% endfor %}
      {% endfor %}
    </div>
  {% endif %}

  {% if section.settings.button_label != blank %}
    <div class="center">
      <a class="button button--black" href="{{ section.settings.button_link | default: collection.url | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"Best Seller"},
    {"type":"collection","id":"collection","label":"Collection"},
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "products",
      "options": [
        {"value":"products","label":"Products grid"},
        {"value":"category","label":"Category cards"},
        {"value":"showcase","label":"Watch and buy"}
      ]
    },
    {"type":"range","id":"columns","label":"Columns","min":2,"max":4,"step":1,"default":4},
    {"type":"range","id":"product_limit","label":"Products","min":3,"max":12,"step":1,"default":8},
    {"type":"checkbox","id":"show_sale_badge","label":"Show sale badge","default":false},
    {"type":"text","id":"button_label","label":"Button label"},
    {"type":"url","id":"button_link","label":"Button link"}
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category card",
      "settings": [
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"text","id":"title","label":"Title","default":"Category"},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ],
  "presets": [{"name":"Featured collection"}]
}
{% endschema %}
