{{ 'yova-product-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'yova-product-card.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign yova_collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
  assign heading_text = section.settings.heading | default: yova_collection.title
  assign slider_enabled = false
  if section.settings.enable_slider_desktop or section.settings.enable_slider_mobile
    assign slider_enabled = true
  endif
-%}

<section
  class="yova-section color-{{ section.settings.color_scheme }}{% if section.settings.desktop_full_width %} yova-section--desktop-full{% endif %}{% if section.settings.mobile_full_width %} yova-section--mobile-full{% endif %}"
  style="
    --yova-section-bg: {{ section.settings.section_background }};
    --yova-section-max: {{ section.settings.section_max_width }}px;
    --yova-container-max: {{ section.settings.desktop_container_width }}px;
    --yova-container-radius: {{ section.settings.container_radius }}px;
    --yova-pad-top-d: {{ section.settings.padding_top_desktop }}px;
    --yova-pad-bottom-d: {{ section.settings.padding_bottom_desktop }}px;
    --yova-pad-left-d: {{ section.settings.padding_left_desktop }}px;
    --yova-pad-right-d: {{ section.settings.padding_right_desktop }}px;
    --yova-pad-top-m: {{ section.settings.padding_top_mobile }}px;
    --yova-pad-bottom-m: {{ section.settings.padding_bottom_mobile }}px;
    --yova-pad-left-m: {{ section.settings.padding_left_mobile }}px;
    --yova-pad-right-m: {{ section.settings.padding_right_mobile }}px;
    --yova-heading-align-d: {{ section.settings.heading_alignment_desktop }};
    --yova-heading-align-m: {{ section.settings.heading_alignment_mobile }};
    --yova-heading-size-d: {{ section.settings.heading_size_desktop }}px;
    --yova-heading-size-m: {{ section.settings.heading_size_mobile }}px;
    --yova-heading-weight: {{ section.settings.heading_weight }};
    --yova-heading-color: {{ section.settings.heading_color }};
    --yova-subheading-color: {{ section.settings.subheading_color }};
    --yova-heading-gap: {{ section.settings.heading_spacing }}px;
    --yova-desktop-cols: {{ section.settings.columns_desktop }};
    --yova-tablet-cols: {{ section.settings.columns_tablet }};
    --yova-mobile-cols: {{ section.settings.columns_mobile }};
    --yova-gap-d: {{ section.settings.gap_desktop }}px;
    --yova-gap-t: {{ section.settings.gap_tablet }}px;
    --yova-gap-m: {{ section.settings.gap_mobile }}px;
    --yova-view-radius: {{ section.settings.view_all_radius }}px;
    --yova-view-px: {{ section.settings.view_all_padding_x }}px;
    --yova-view-py: {{ section.settings.view_all_padding_y }}px;
    --yova-view-size: {{ section.settings.view_all_font_size }}px;
    --yova-view-border: {{ section.settings.view_all_border_color }};
    --yova-view-bg: {{ section.settings.view_all_background }};
    --yova-view-color: {{ section.settings.view_all_color }};
    --yova-view-hover-bg: {{ section.settings.view_all_hover_background }};
    --yova-view-hover-color: {{ section.settings.view_all_hover_color }};
  "
  data-section-id="{{ section.id }}"
>
  <div class="yova-section__shell">
    <div class="yova-section__inner">
      {%- if heading_text != blank or section.settings.subheading != blank or section.settings.show_view_all -%}
        <div class="yova-section__header yova-section__header--view-desktop-{{ section.settings.view_all_position_desktop }} yova-section__header--view-mobile-{{ section.settings.view_all_position_mobile }}">
          <div class="yova-section__heading-wrap">
            {%- if section.settings.subheading != blank -%}<p class="yova-section__eyebrow">{{ section.settings.subheading }}</p>{%- endif -%}
            {%- if heading_text != blank -%}<h2 class="yova-section__title">{{ heading_text }}</h2>{%- endif -%}
          </div>
          {%- if section.settings.show_view_all and yova_collection != blank -%}
            <a class="yova-section__view-all" href="{{ yova_collection.url }}" aria-label="{{ section.settings.view_all_label | escape }} {{ yova_collection.title | escape }}">{{ section.settings.view_all_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="yova-product-rail{% if slider_enabled %} yova-slider{% endif %}{% if section.settings.enable_slider_desktop %} yova-slider--desktop{% endif %}{% if section.settings.enable_slider_mobile %} yova-slider--mobile{% endif %}"{% if slider_enabled %} data-yova-slider data-autoplay="{{ section.settings.autoplay }}" data-loop="{{ section.settings.loop }}" data-speed="{{ section.settings.slider_speed }}"{% endif %}>
        <div class="yova-grid" role="list">
          {%- if yova_collection != blank and yova_collection.products_count > 0 -%}
            {%- for product in yova_collection.products limit: products_to_show -%}
              <div class="yova-grid__item" role="listitem">
                {% render 'yova-product-card', product_card_product: product, card_background: section.settings.card_background, card_radius: section.settings.card_radius, border_color: section.settings.card_border_color, border_width: section.settings.card_border_width, card_shadow: section.settings.shadow, hover_shadow: section.settings.hover_shadow, hover_lift: section.settings.hover_lift, card_padding: section.settings.card_padding, card_gap: section.settings.card_vertical_gap, image_ratio: section.settings.image_ratio, image_radius: section.settings.image_radius, image_padding: section.settings.image_padding, image_background: section.settings.image_background, enable_hover_image: section.settings.enable_hover_image, image_hover_zoom: section.settings.image_hover_zoom, image_scale: section.settings.image_scale, image_object_fit: section.settings.image_object_fit, show_badge: section.settings.enable_badge, badge_radius: section.settings.badge_radius, badge_font_size: section.settings.badge_font_size, badge_padding_x: section.settings.badge_padding_x, badge_padding_y: section.settings.badge_padding_y, badge_position: section.settings.badge_position, badge_background: section.settings.badge_background, badge_color: section.settings.badge_color, show_countdown: section.settings.enable_countdown, countdown_position: section.settings.countdown_position, countdown_radius: section.settings.countdown_radius, countdown_background: section.settings.countdown_background, countdown_color: section.settings.countdown_color, title_size_desktop: section.settings.title_size_desktop, title_size_mobile: section.settings.title_size_mobile, title_weight: section.settings.title_weight, title_line_clamp: section.settings.title_line_clamp, title_color: section.settings.title_color, title_spacing: section.settings.title_spacing, show_description: section.settings.enable_description, description_size_desktop: section.settings.description_size_desktop, description_size_mobile: section.settings.description_size_mobile, description_color: section.settings.description_color, description_line_clamp: section.settings.description_line_clamp, description_spacing: section.settings.description_spacing, price_size: section.settings.price_size, compare_price_size: section.settings.compare_price_size, discount_size: section.settings.discount_size, price_spacing: section.settings.price_spacing, price_color: section.settings.price_color, discount_color: section.settings.discount_color, show_compare_price: section.settings.enable_compare_price, show_discount: section.settings.enable_discount, show_rating: section.settings.enable_rating, rating_font_size: section.settings.rating_font_size, rating_icon_size: section.settings.rating_icon_size, rating_spacing: section.settings.rating_spacing, show_weight: section.settings.enable_weight, weight_radius: section.settings.weight_radius, weight_padding_x: section.settings.weight_padding_x, weight_padding_y: section.settings.weight_padding_y, weight_position: section.settings.weight_position, weight_font_size: section.settings.weight_font_size, show_quick_add: section.settings.enable_quick_add, use_ajax: section.settings.enable_ajax_cart, button_style: section.settings.button_style, button_color: section.settings.button_color, button_text_color: section.settings.button_text_color, button_hover_color: section.settings.button_hover_color, button_hover_text_color: section.settings.button_hover_text_color, button_radius: section.settings.button_radius, button_height_desktop: section.settings.button_height_desktop, button_height_mobile: section.settings.button_height_mobile, button_padding_x: section.settings.button_padding_x, button_padding_y: section.settings.button_padding_y, button_size_desktop: section.settings.button_size_desktop, button_size_mobile: section.settings.button_size_mobile, button_width: section.settings.button_width, lazy_loading: section.settings.lazy_loading, fetchpriority: forloop.first %}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
