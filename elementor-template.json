   <div class=\"text-yellow-400 text-sm\">★★★★★</div>\n            <p class=\"mt-3 text-sm text-zinc-200\">\n              “Finally stopped guessing and started earning. Best investment for my digital journey.”\n            </p>\n            <div class=\"mt-5 flex items-center gap-3\">\n              <div class=\"h-9 w-9 rounded-full bg-white/5 ring-1 ring-white/10 flex items-center justify-center text-yellow-300 text-xs\">A</div>\n              <div>\n                <p class=\"text-sm font-semibold\">Asha L.</p>\n                <p class=\"text-xs text-zinc-500\">Side Hustler</p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <p class=\"mt-6 text-center text-xs text-zinc-500\">\n          Results vary. Vault helps with product selection & speed.\n        </p>\n      </div>\n    </section>\n\n    <!-- PRICING CARD -->\n    <section class=\"py-12 sm:py-14 border-t border-white/5\">\n      <div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div class=\"flex justify-center\">\n          <div class=\"w-full max-w-md rounded-3xl bg-[#0f1117] ring-1 ring-yellow-400/25 shadow-[0_0_0_1px_rgba(250,204,21,.14),0_40px_120px_rgba(0,0,0,.65)] p-5 sm:p-6 relative overflow-hidden\">\n            <div aria-hidden=\"true\" class=\"absolute inset-0 bg-gradient-to-b from-yellow-400/10 via-transparent to-transparent\"></div>\n\n            <div class=\"relative\">\n              <div class=\"flex items-start justify-between gap-3\">\n                <div>\n                  <h3 class=\"text-lg font-semibold\">Digital Product Vault</h3>\n                  <p class=\"mt-1 text-xs text-zinc-500\">One-time payment, lifetime access</p>\n                </div>\n                <span class=\"text-[10px] rounded-full bg-yellow-400/10 ring-1 ring-yellow-400/20 px-2 py-1 text-yellow-300\">\n                  ₹299 VAULT\n                </span>\n              </div>\n\n              <div class=\"mt-6 text-center\">\n                <p class=\"text-xs text-zinc-500 line-through\">₹999</p>\n                <p class=\"text-4xl font-semibold text-yellow-400\">₹299</p>\n                <p class=\"mt-2 text-xs text-yellow-300\">Save 70% • Limited time offer</p>\n              </div>\n\n              <ul class=\"mt-6 space-y-3 text-sm text-zinc-200\">\n                <li class=\"flex gap-3\"><span class=\"text-yellow-400\">✓</span> 1000+ Digital Product Ideas</li>\n                <li class=\"flex gap-3\"><span class=\"text-yellow-400\">✓</span> Ready-to-Use Templates & Assets</li>\n                <li class=\"flex gap-3\"><span class=\"text-yellow-400\">✓</span> Sales Page Examples</li>\n                <li class=\"flex gap-3\"><span class=\"text-yellow-400\">✓</span> Beginner-Friendly Guides</li>\n                <li class=\"flex gap-3\"><span class=\"text-yellow-400\">✓</span> Lifetime Access</li>\n                <li class=\"flex gap-3\"><span class=\"text-yellow-400\">✓</span> Future Updates Included</li>\n              </ul>\n\n              <a\n                href=\"https://superprofile.link/YOUR_CHECKOUT\"\n                class=\"mt-7 w-full min-h-[48px] inline-flex items-center justify-center rounded-xl bg-yellow-400 text-black font-semibold text-base py-3 px-4 hover:bg-yellow-300 transition\"\n              >\n                Unlock the Vault Now\n              </a>\n\n              <p class=\"mt-3 text-center text-xs text-zinc-500\">\n                ○ Secure checkout via SuperProfile • UPI/Card • Instant access\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- FAQ -->\n    <section class=\"py-12 sm:py-14 border-t border-white/5\">\n      <div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div class=\"text-center\">\n          <h2 class=\"text-2xl lg:text-3xl font-semibold\">Frequently Asked Questions</h2>\n          <p class=\"mt-2 text-sm sm:text-base text-zinc-500\">Got questions? We’ve got answers.</p>\n        </di